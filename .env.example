# Database (Neon Serverless Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Razorpay Test Mode (server-side)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_test_secret"

# Same test key id, exposed to the browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"

# Optional — webhook signature verification is skipped silently if unset
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Groq AI (agent LLM — openai/gpt-oss-120b)
GROQ_API_KEY="your_groq_api_key_here"

# Optional — where the website's chat backend reaches the MCP server. Defaults to
# the incoming request origin (same deployment). Set this only if you host the MCP
# server separately from the website.
# MCP_BASE_URL="https://your-acg-deployment.example.com"

